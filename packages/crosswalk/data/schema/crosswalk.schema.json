{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbook.dev/crosswalk.schema.json",
  "title": "Proofbook Crosswalk framework file",
  "type": "object",
  "required": ["framework", "version", "crosswalk_version", "controls"],
  "additionalProperties": false,
  "properties": {
    "framework": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "crosswalk_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": ["id", "title", "requirement_summary", "assertions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "article": { "type": "string" },
        "title": { "type": "string" },
        "requirement_summary": {
          "type": "string",
          "description": "Original paraphrase. Never the text of the standard."
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["id", "description", "source_class", "expression", "verdict_map"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "description": { "type": "string" },
        "source_class": { "enum": ["observed", "configured", "declared"] },
        "capability": { "type": "string" },
        "expression": { "type": "string" },
        "partial_expression": { "type": "string" },
        "evidence": {
          "type": "object",
          "required": ["selector"],
          "additionalProperties": false,
          "properties": {
            "selector": { "type": "string" },
            "sample": { "type": "integer", "minimum": 1 },
            "summarise": {
              "type": "array",
              "items": {
                "enum": ["count", "date_range", "distinct_agents", "distinct_models", "distinct_tools", "rate"]
              }
            }
          }
        },
        "verdict_map": {
          "type": "object",
          "required": ["pass", "fail", "no_data"],
          "additionalProperties": false,
          "properties": {
            "pass": { "const": "evidenced" },
            "partial": { "const": "partially_evidenced" },
            "fail": { "enum": ["not_evidenced", "contradicted"] },
            "no_data": {
              "const": "unevaluable",
              "description": "Format-level invariant: missing data can never map to a pass."
            }
          }
        }
      }
    }
  }
}
